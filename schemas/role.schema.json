{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "why-bureau role definition",
  "description": "Describes a role, which may request capabilities but never hands any out. See MODEL.md, section 'Roles'; properties follow the field order there. Schema version 0.1.",
  "$comment": "Enforced because Required: non-author review. Optional because Suggested: minimum grade, record kinds written, escalation path, keeping the reviewer apart from earlier attempts, and a reviewer from another vendor family. Any field that is present must still match the shape below.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "purpose",
    "permission_class",
    "write_scope",
    "tools",
    "isolation_grade",
    "independence",
    "sentinels"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "purpose": { "type": "string", "minLength": 1 },
    "permission_class": {
      "enum": [
        "fixture-repair",
        "doc-link-repair",
        "dev-test-change",
        "behaviour-preserving-speed-change",
        "approved-item-fix"
      ]
    },
    "write_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "record_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["evidence", "code", "knowledge", "design", "purpose"] }
        }
      }
    },
    "tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "isolation_grade": { "enum": ["G0", "G1", "G2", "G3"] },
    "minimum_grade": { "enum": ["fast", "build-lite", "build", "review", "senior", "top"] },
    "top_grade_set_by": {
      "type": "string",
      "minLength": 1,
      "description": "The person who explicitly set the top grade as this role's minimum."
    },
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["non_author_review"],
      "properties": {
        "non_author_review": { "const": true },
        "independent_of_prior_attempts": { "type": "boolean" },
        "different_vendor_review": { "type": "boolean" }
      }
    },
    "escalation_path": { "$ref": "escalation-path.schema.json" },
    "sentinels": { "type": "string", "pattern": "^sentinels/[a-z][a-z0-9-]*/?$" }
  },
  "allOf": [
    {
      "if": { "required": ["minimum_grade"], "properties": { "minimum_grade": { "const": "top" } } },
      "then": { "required": ["top_grade_set_by"] }
    }
  ]
}
